# AgentsPilot Marketing Site - Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================
# Main App URL (Required for redirects after auth)
# ============================================
# Where the platform lives. Every redirect out of this site after sign-in,
# sign-up or onboarding goes here, so a wrong value strands people mid-auth.
#
#   local       http://localhost:3000
#   Vercel      https://neuronforge-kohl.vercel.app
#   production  https://app.agentspilot.ai
NEXT_PUBLIC_MAIN_APP_URL=http://localhost:3000

# ============================================
# THIS site's own URL
# ============================================
# Used for `emailRedirectTo` on sign-up, which must point at THIS origin's
# /auth/callback — not the platform's. Both apps have a route by that name, so
# setting this to the platform URL sends confirmation links to the wrong app and
# the mistake looks like it works.
#
# Leave empty to use window.location.origin, which is correct in every
# environment; set it only if you need to override that.
#
# WHICHEVER value ends up here, it must also be in Supabase's Redirect URLs
# allow-list. If it is not, Supabase ignores it SILENTLY and falls back to the
# project's Site URL — which is why auth can work on localhost and break on
# Vercel with no error anywhere.
NEXT_PUBLIC_APP_URL=

# ============================================
# Supabase Configuration (Required)
# ============================================
# Use the SAME credentials as your main app (neuronforge)
# Both apps share the same Supabase project for authentication

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key for API routes (server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# Gmail OAuth (Optional - for contact form)
# ============================================
# Only needed if you want the contact form to send emails via Gmail
# Leave empty to disable email sending from contact form

GMAIL_USER=your_email@gmail.com
GMAIL_CLIENT_ID=your_gmail_oauth_client_id
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token

# ============================================
# Notes
# ============================================
# 1. NEXT_PUBLIC_* variables are exposed to the browser
# 2. Variables without NEXT_PUBLIC_ are server-side only
# 3. Never commit .env.local to git (it's in .gitignore)
# 4. Update NEXT_PUBLIC_MAIN_APP_URL when deploying to production
# 5. Supabase credentials must match the main app exactly

# ============================================
# Homepage release gates (2026-10 redesign)
# ============================================
# Each gate guards a CLAIM. The default when unset is the safe fallback, so
# publishing a claim is a deliberate act — see lib/marketing/config.ts.
#
# NEXT_PUBLIC_* is inlined at BUILD time, not read at runtime. Changing one of
# these needs a rebuild and redeploy; setting it on a running server does
# nothing.

# Publish the real plans: Essentials $79 and Autopilot $129, from the app's own
# tierMatrix.ts. Unset shows "Let's find the right fit for your business" with a
# demo CTA instead. The CTA goes to onboarding either way — production checkout
# is still off (BUSINESS_OS_PLAN_CHECKOUT_ENABLED), so no price is payable yet.
NEXT_PUBLIC_SHOW_PRICING=true

# Offer "approved rules handle future follow-ups" in the delegation section.
# Unset describes draft-and-review only, which is the behaviour that exists
# without it. Requires real stop rules (reply / book / opt-out) and a pause.
NEXT_PUBLIC_SHOW_AUTONOMY=true

# The day-by-day panel of which areas the advisor can speak about. Draft copy,
# and it describes the real vector-maturity mechanism. Days are illustrative.
NEXT_PUBLIC_SHOW_INSIGHT_GROWTH=true

# Optional overrides. Each defaults to a sensible in-site route; an unset
# PRIVACY/TERMS renders as plain text rather than a dead link.
# NEXT_PUBLIC_ONBOARDING_URL=
# NEXT_PUBLIC_SCHEDULING_URL=
# NEXT_PUBLIC_SIGNIN_URL=
# NEXT_PUBLIC_CONTACT_URL=
# NEXT_PUBLIC_PRIVACY_URL=
# NEXT_PUBLIC_TERMS_URL=
# Set to `false` to turn every primary CTA into "Book a demo", globally.
# NEXT_PUBLIC_SELF_SERVICE_ONBOARDING=true
